#!/usr/bin/env bash
# provledger — on the Bash tool's PATH while the plugin is enabled (Claude Code puts
# a plugin's top-level bin/ there). The command itself lives in the plugin's venv,
# which the SessionStart bootstrap builds; this hands every call to it (FL-195).
# A session that loaded the plugin with /reload-plugins never ran SessionStart, so
# the first call builds the venv itself, with the same bootstrap.
VENV="${PROVLEDGER_VENV:-$HOME/skill-workspace/.venv}"
if [ ! -x "$VENV/bin/provledger" ] && [ ! -x "$VENV/bin/python" ]; then
    ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    echo "provledger: no venv at $VENV yet — building it with the plugin's bootstrap (once)" >&2
    bash "$ROOT/scripts/bootstrap.sh" >&2
fi
if [ -x "$VENV/bin/provledger" ]; then exec "$VENV/bin/provledger" "$@"; fi
if [ -x "$VENV/bin/python" ]; then exec "$VENV/bin/python" -m provledger.cli "$@"; fi
echo "provledger: no venv at $VENV — the plugin's bootstrap (scripts/bootstrap.sh) did not build one" >&2
exit 127
